# === Scraping ===
APIFY_API_TOKEN=apify_api_...

# === AI ===
HUGGINGFACE_API_KEY=hf_...

# === Email — Gmail OAuth ===
# Download credentials.json from Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client ID > Desktop app)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
DIGEST_RECIPIENT=you@gmail.com

# === Email — SMTP fallback ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# === Job Preferences ===
TARGET_ROLES=PM,TPM,Product Manager,Technical Program Manager,Full Stack Engineer,Software Engineer
TARGET_LOCATIONS=San Francisco,New York,Remote,Austin,Seattle
EXPERIENCE_YEARS=5
MIN_JOB_MATCH_SCORE=0.55

# === Contact Finder (optional — Hunter.io for work emails) ===
HUNTER_API_KEY=

# === Scheduler ===
DIGEST_SEND_TIME=07:00
